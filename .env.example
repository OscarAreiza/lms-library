# Copy to .env and adjust — never commit the real .env file.

# ---- Database ----
# Shared credentials across all per-service Postgres instances (access-db,
# membership-db, catalog-db, circulation-db) — each has its own database name,
# set directly in docker-compose.yml.
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password

# ---- Services ----
# JWT_SECRET is shared by every service: access-service issues the token,
# the others validate it — no separate token-introspection call needed.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRY=1h
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
